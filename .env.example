# ─── Database ───────────────────────────────────────────────────────────────
# Production / recommended local: Postgres (Neon, Supabase, or local Docker)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/echelon?sslmode=require"
# Neon: use the non-pooled connection for migrations. Same as DATABASE_URL if N/A.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/echelon?sslmode=require"

# Optional local SQLite path (instead of Postgres):
# 1) Set DATABASE_URL="file:./prisma/dev.db" (path relative to repo root for Next runtime)
#    Prisma CLI with --schema prisma/schema.sqlite.prisma also accepts "file:./dev.db"
# 2) npm run db:sqlite:generate && npm run db:sqlite:push && npm run db:sqlite:seed
# 3) Use npm run db:sqlite:* for later Prisma commands (not the default Postgres scripts)

# ─── Auth (NextAuth / Auth.js) ───────────────────────────────────────────────
# Required in production — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Canonical site URL (Auth.js). On Vercel also set this to https://your-domain.
AUTH_URL="http://localhost:43127"
# Legacy alias still read by some tooling
NEXTAUTH_URL="http://localhost:43127"

# Public URL for invite links (defaults to AUTH_URL / NEXTAUTH_URL / VERCEL_URL)
# APP_BASE_URL="https://echelon.yourdomain.com"

# ─── Invite email (Resend) ───────────────────────────────────────────────────
# When both are set, coach invites are emailed. Otherwise the invite URL is
# logged on the server and shown in Coach → Clients for copy/paste.
# RESEND_API_KEY="re_xxx"
# INVITE_FROM_EMAIL="Echelon <onboarding@yourdomain.com>"

# ─── Seed passwords (optional) ───────────────────────────────────────────────
# SEED_COACH_PASSWORD="coach123"
# SEED_CLIENT_PASSWORD="client123"
