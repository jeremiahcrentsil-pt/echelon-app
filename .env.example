# SQLite database (relative to prisma/ when using file:./dev.db)
DATABASE_URL="file:./dev.db"

# NextAuth — required in production; a local default is used if unset in development
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:43127"

# Optional: override seed demo passwords (defaults shown)
# SEED_COACH_PASSWORD="coach123"
# SEED_CLIENT_PASSWORD="client123"
