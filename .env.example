# SQLite database (relative to prisma/ when using file:./dev.db)
DATABASE_URL="file:./dev.db"

# NextAuth — required in production; a local default is used if unset in development
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:43127"

# Public app URL used when building invite links (defaults to NEXTAUTH_URL)
# APP_BASE_URL="http://localhost:43127"

# Optional email delivery for client invites (Resend).
# If unset, invite URLs are logged to the server console and shown in Coach UI for copy/paste.
# RESEND_API_KEY="re_xxx"
# INVITE_FROM_EMAIL="Echelon <onboarding@yourdomain.com>"

# Optional: override seed demo passwords (defaults shown)
# SEED_COACH_PASSWORD="coach123"
# SEED_CLIENT_PASSWORD="client123"
